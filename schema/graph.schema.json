{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modulegraph.dev/schema/graph.schema.json",
  "title": "ModuleGraph",
  "type": "object",
  "required": ["version", "project", "nodes", "edges"],
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["app", "library", "test", "executable", "macro", "system", "external"] },
          "package": { "type": "string" },
          "group": { "type": "string" },
          "path": { "type": "string" },
          "sourceFiles": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "enum": ["declared", "import"] },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "path": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
